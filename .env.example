# Copia questo file in .env solo per provare l'app sul tuo computer.
# Su Render queste impostazioni si inseriscono in "Environment", mai nel codice.

DATABASE_URL=postgres://utente:password@localhost:5432/mappa_protocolli
SESSION_SECRET=una-frase-lunga-e-casuale

# Amministratore principale (si apre su /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=scegli-una-password-lunga
ADMIN_NAME=Giancarlo

# Assistente AI: openai | anthropic | gemini
AI_PROVIDER=gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Facoltativo: modello da usare (altrimenti quello predefinito del fornitore)
AI_MODEL=
